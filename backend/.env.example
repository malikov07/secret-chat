# Copy to .env and adjust
SECRET_KEY=dev-insecure-change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database: set DB_ENGINE=sqlite to try instantly with no setup, or leave as postgres.
DB_ENGINE=postgres
# PostgreSQL
DB_NAME=secret_chat
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432

# Frontend origin (React dev server)
FRONTEND_ORIGIN=http://localhost:5173

# Channels: leave empty to use in-memory layer (dev). Set to redis://127.0.0.1:6379/0 for production.
REDIS_URL=
