{
  "name": "Secret Chat",
  "description": "A private chat, shared memories and dreams for two.",
  "repository": "https://github.com/your-username/secret-chat",
  "buildpacks": [
    { "url": "heroku/nodejs" },
    { "url": "heroku/python" }
  ],
  "addons": [
    "heroku-postgresql:essential-0"
  ],
  "env": {
    "SECRET_KEY": { "generator": "secret" },
    "DEBUG": { "value": "False" }
  }
}
