# Copy this to  backend/.env  on the server and fill it in.
# Django reads it automatically at startup.

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
# Your VM's public IP and/or domain (comma-separated). Must match how you open the site.
ALLOWED_HOSTS=YOUR_VM_PUBLIC_IP,your-domain.com

# --- PostgreSQL on the VM (created during setup) ---
DB_ENGINE=postgres
DB_NAME=secret_chat
DB_USER=secret
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=5432
# ...or, instead of the DB_* vars, use a single URL (e.g. a managed Postgres service):
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# Single daphne process uses an in-memory channel layer. Only set this if you
# run multiple workers/instances:
# REDIS_URL=redis://127.0.0.1:6379/0

# Uploads are stored outside the code dir so they survive redeploys / re-clones.
# This path MUST match the `alias` in deploy/nginx.conf's `location /media/`.
MEDIA_ROOT=/var/secret-chat/media

# --- After you set up HTTPS (certbot), enable these ---
# USE_HTTPS=True
# CSRF_TRUSTED_ORIGINS=https://your-domain.com
