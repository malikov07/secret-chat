# Secret Chat — systemd unit for the daphne ASGI server.
# Install: sudo cp deploy/secret-chat.service /etc/systemd/system/
#          (edit User / paths if your layout differs)
#          sudo systemctl daemon-reload
#          sudo systemctl enable --now secret-chat
[Unit]
Description=Secret Chat (Django + Channels via daphne)
After=network.target postgresql.service

[Service]
User=azureuser
Group=azureuser
WorkingDirectory=/opt/secret-chat/backend
ExecStart=/opt/secret-chat/backend/venv/bin/daphne -b 127.0.0.1 -p 8000 config.asgi:application
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
